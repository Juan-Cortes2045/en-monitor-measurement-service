<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

        <!--
            Only the measurement changesets. The schema is shared with energy-monitor-backend, the
            security service and the device service (ADR-003), and so is the DATABASECHANGELOG
            table: each service applies its own changelogs.

            The measurement changelogs keep the relative path they have in energy-monitor-backend:
            Liquibase identifies a changeset by id, author and file path, so the changesets the
            monolith already applied to the shared schema are recognised here as applied and
            never run twice.
        -->
        <include file="measurement/measurement-changelog.xml" relativeToChangelogFile="true"/>
</databaseChangeLog>
