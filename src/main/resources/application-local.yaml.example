# Local profile: copy to application-local.yaml (gitignored) and set the database password.
#
# Only what differs per machine lives here; the rest is read from .env (see .env.example).

spring:
  datasource:
    # The schema shared with energy-monitor-backend, the security service and the device service
    # (MySQL from the infra repository).
    url: jdbc:mysql://localhost:3306/energy_monitor?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
    username: energy_app
    password: "CHANGE_ME"
