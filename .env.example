# Copy this file to .env and replace every CHANGE_ME. It is in .gitignore: never commit it.
#
# Spring reads it in .properties format, so write values without quotes and without $:
# a value containing $ is treated as a placeholder and the application fails to start.

# Database. MySQL runs from the infra repository, which creates the energy_app user with
# MYSQL_PASSWORD of infra/.env. Put that same password here: the tests need it, because the
# "test" profile does not load application-local.yaml.
SPRING_DATASOURCE_PASSWORD=

# HTTP port. 8080 is the API gateway, 8082 the security service, 8083 energy-monitor-backend and
# 8084 the device service on the same machine.
# SERVER_PORT=8085

# Public key of the security service, to validate the access tokens. Absolute path.
SECURITY_JWT_PUBLIC_KEY_PATH=/home/CHANGE_ME/.energy-monitor/keys/public.pem

# Calls to energy-monitor-backend (is the caller a member of the home? its limits) and to the
# device service (which home is a device linked to?). The same token goes in the .env of every
# service; generate one with: openssl rand -hex 32
INTERNAL_API_TOKEN=CHANGE_ME_internal_api_token
BACKEND_INTERNAL_URL=http://localhost:8083
DEVICE_SERVICE_URL=http://localhost:8084

# A reading older than this no longer counts as current power. Same value as the device service.
# DEVICE_OFFLINE_AFTER=PT150S

# Message broker (RabbitMQ from infra). The device service announces links and unlinks there,
# which keep the cache of devices current; without a broker it expires after 30 s instead and the
# health is DOWN.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=energy-monitor
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_password
